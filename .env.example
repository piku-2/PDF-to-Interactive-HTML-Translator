# カンマ区切り。空白は無視、大文字は小文字として読む。
# 空なら anthropic,gemini,openai,grok,deepseek,kimi,glm,openrouter,nvidia_nim
# キーが入っているプロバイダーだけが並び、左がメイン。失敗すると右へ落ちる。
LLM_PROVIDER_PRIORITY=anthropic,gemini,openai,grok,deepseek,kimi,glm,openrouter,nvidia_nim

# 使うものだけでOK。空欄・changeme・末尾が ... の値は無効。
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Grok は GROK_API_KEY を優先。無ければ XAI_API_KEY。
GROK_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
